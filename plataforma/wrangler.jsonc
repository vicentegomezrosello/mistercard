{
  // Plataforma multi-vendedor de tiendas TCG. Independiente de mistercard.es.
  "name": "tiendas-tcg",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tiendas-tcg", "database_id": "PENDIENTE", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "tiendas-tcg-fotos" }
  ],
  "vars": {
    // Dominio de la plataforma (donde vive el superpanel). Se cambia al publicar.
    "HOST_PLATAFORMA": "tiendas-tcg.workers.dev",
    "NOMBRE_WORKER": "tiendas-tcg"
  },
  "observability": { "enabled": true }
  // Secretos (se ponen en Cloudflare, nunca en este archivo):
  //   SUPER_CLAVE    contraseña del superpanel (usuario: admin)
  //   CF_API_TOKEN   token de Cloudflare para conectar dominios
  //   CF_ACCOUNT_ID  id de la cuenta de Cloudflare
}
